@model List<CsArsenal.Models.Item>
@{
    ViewData["Title"] = "Каталог";
}

<h1>Каталог оружия</h1>

@if (Model.Count == 0)
{
    <div class="block">
        <p>В каталоге пока нет записей.</p>
    </div>
}
else
{
    @foreach (var item in Model)
    {
        <partial name="_Card" model="item" />
    }
}
