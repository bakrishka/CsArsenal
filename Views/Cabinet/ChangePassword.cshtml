@model CsArsenal.Models.ChangePasswordModel
@{
    ViewData["Title"] = "Смена пароля";
}

<h1>Смена пароля</h1>
<partial name="_CabinetMenu" />

<div class="block">
    @if (TempData["Message"] != null)
    {
        <p class="ok-msg">@TempData["Message"]</p>
    }
    <form asp-controller="Cabinet" asp-action="ChangePassword" method="post">
        <p>
            Старый пароль:
            <input asp-for="OldPassword" type="password" class="form-control" />
            <span asp-validation-for="OldPassword"></span>
        </p>
        <p>
            Новый пароль:
            <input asp-for="NewPassword" type="password" class="form-control" />
            <span asp-validation-for="NewPassword"></span>
        </p>
        <p>
            Повторите новый пароль:
            <input asp-for="ConfirmPassword" type="password" class="form-control" />
            <span asp-validation-for="ConfirmPassword"></span>
        </p>
        <button type="submit" class="btn btn-primary">Сменить пароль</button>
    </form>
</div>
