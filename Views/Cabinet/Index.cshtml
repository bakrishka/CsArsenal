@{
    ViewData["Title"] = "Личный кабинет";
}

<h1>Личный кабинет</h1>
<partial name="_CabinetMenu" />

<div class="block">
    <p>Добро пожаловать, @User.Identity?.Name!</p>
    <p>У вас @ViewBag.Count записей.</p>
    @if (User.IsInRole("Admin"))
    {
        <p class="meta">Ваша роль: Администратор (доступно редактирование и удаление любых записей в каталоге).</p>
    }
    <a class="btn btn-primary" asp-controller="Cabinet" asp-action="Create">Добавить запись</a>
</div>
