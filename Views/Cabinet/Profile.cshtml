@model CsArsenal.Models.ProfileModel
@{
    ViewData["Title"] = "Профиль";
}

<h1>Профиль</h1>
<partial name="_CabinetMenu" />

<div class="block">
    <p>Дата регистрации: @Model.RegisteredAt.ToString("dd.MM.yyyy")</p>
    @if (TempData["Message"] != null)
    {
        <p class="ok-msg">@TempData["Message"]</p>
    }
    <form asp-controller="Cabinet" asp-action="Profile" method="post">
        <input type="hidden" asp-for="RegisteredAt" />
        <p>
            Имя:
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name"></span>
        </p>
        <p>
            Email:
            <input asp-for="Email" class="form-control" />
            <span asp-validation-for="Email"></span>
        </p>
        <button type="submit" class="btn btn-primary">Сохранить</button>
    </form>
</div>
